// Program 1: اساسيات.mizan
برنامج حسابات_رياضية؛

ثابت الحد_الاقصى: صحيح = 10؛
متغير النتيجة: صحيح = 0؛
متغير عداد_الثواني: صحيح = 0؛
متغير المجموع: صحيح = 0؛
متغير عداد: صحيح = 0؛

اجراء حساب_المجموع(الحد: صحيح) يرجع صحيح {
    المجموع = 0؛
    عداد = 0؛
    طالما (عداد <= الحد) {
        المجموع = المجموع + عداد؛
        عداد = عداد + 1؛
    }
    ارجع المجموع؛
}

وضع اقلاع {
    عند_بدء {
        سجل_حادثة "بدء برنامج الحسابات"؛
        النتيجة = نفذ اجراء حساب_المجموع(5)؛
        
        اذا (النتيجة > 10) {
            سجل_حادثة "النتيجة أكبر من 10"؛
        } والا {
            سجل_حادثة "النتيجة أقل من أو تساوي 10"؛
        }
        
        عداد_الثواني = 0؛
        طالما (عداد_الثواني < 3) {
            سجل_حادثة "انتظار..."؛
            عداد_الثواني = عداد_الثواني + 1؛
            انتظر 1 ثانية؛
        }
    }
}