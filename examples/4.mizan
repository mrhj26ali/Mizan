// sample_4_reports.mizan
برنامج التقارير_والتصعيد؛

جهاز وحدة_التحكم {
    نوع: "PLC",
    بروتوكول: "modbus_tcp",
    عنوان_ip: "127.0.0.1",
    منفذ: 5020,
    دورة_مسح: 500 مللي_ثانية,
};

حساس الضغط {
    نوع: بار,
    نطاق: [0..10],
    عنوان: 0x0002,
};

مشغل مضخة_الحقن {
    نوع: منطقي,
    عنوان: 0x0024,
};

// ✅ DEMO: ISA-18.2 Escalation Chain (Routes to MQTT)
تصعيد سلسلة_الطوارئ {
    مستوى_1 {
        رسالة: "ضغط حرج",
        مستلم: "مشغل_الوردية",
        مهلة: 10 ثانية,
        عند_انتهاء_المهلة: انتقل_الى مستوى_2,
    },
    مستوى_2 {
        رسالة: "خطر انفجار!",
        مستلم: "مدير_المصنع",
        مهلة: 5 ثانية,
    }
};

// ✅ DEMO: Predictive Maintenance Report (Fires every 5 seconds)
تقرير تقرير_الصيانة {
    جدول: كل 5 ثانية,
    تنسيق: json,
    حفظ_في: "./reports/cbm",
    محتوى {
        // Automatically tracked by the C-Runtime!
        عدد_تشغيلات(مضخة_الحقن) بعنوان "دورات_المضخة",
        حالة_مشغل(مضخة_الحقن) بعنوان "حالة_المضخة",
        حالة_صحة(الضغط) بعنوان "سلامة_الحساس",
        طابع_زمني بعنوان "الوقت",
    }
};

متغير حالة_الحقن: صحيح = 0؛

وضع اقلاع {
    عند_بدء {
        سجل "بدء نظام التقارير..."؛
        انتقل_الى تشغيل؛
    }
}

وضع تشغيل {
    قاعدة الحقن {
        اذا (الضغط > 8.0) {
            امر مضخة_الحقن: تشغيل؛
            تنبيه مستوى_1 "الضغط مرتفع جداً!"؛
            حالة_الحقن = 1؛
        } والا {
            امر مضخة_الحقن: ايقاف؛
            حالة_الحقن = 0؛
        }
    }
}

انتقالات {
    من اقلاع الى تشغيل؛
}