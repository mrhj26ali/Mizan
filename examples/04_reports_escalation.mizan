برنامج نظام_التقارير؛

جهاز وحدة_التحكم {
    نوع: "PLC",
    بروتوكول: "modbus_tcp",
    عنوان_ip: "127.0.0.1",
    منفذ: 5020,
    دورة_مسح: 1 ثانية
}؛

حساس الضغط {
    نوع: بار؛
    نطاق: [0..10]؛
    عنوان: 0x0002
}؛

تصعيد سلسلة_الضغط {
    مستوى_1 {
        رسالة: "الضغط مرتفع"؛
        مستلم: "مشغل_الوردية"؛
        مهلة: 5 دقيقة؛
        اذا_لم_يستجب_خلال_المهلة: انتقل_الى مستوى_2؛
    }
    مستوى_2 {
        رسالة: "الضغط حرج"؛
        مستلم: "مدير_المصنع"؛
        مهلة: 2 دقيقة؛
    }
}

تقرير تقرير_الضغط {
    جدول: كل_يوم الساعة "00:00"؛
    تنسيق: json؛
    حفظ_في: "./reports"؛
    محتوى {
        متوسط(الضغط خلال: 24 ساعة) بعنوان "متوسط_الضغط"؛
        اقصى(الضغط خلال: 24 ساعة) بعنوان "أقصى_ضغط"؛
    }
}

وضع اقلاع {
    عند_بدء {
        سجل_حادثة "بدء نظام التقارير"؛
        انتقل_الى تشغيل؛
    }
}

وضع تشغيل {
    قاعدة فحص_التقارير {
        متغير حالة: صحيح = 0؛
        متغير عداد: صحيح = 0؛
        شرط: صح؛
        تنفيذ {
            اذا (الضغط > 8.0) {
                حالة = 1؛
            } والا {
                حالة = 0؛
            }
            طالما (عداد < 1) {
                سجل_حادثة "تم التحقق من الضغط"؛
                عداد = عداد + 1؛
            }
        }
    }
}

انتقالات {
    من اقلاع الى تشغيل؛
}