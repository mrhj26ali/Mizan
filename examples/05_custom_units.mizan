برنامج نظام_الوحدات_المخصصة؛

وحدات_مخصصة {
    سرعة : طول / زمن؛
    كثافة : كتلة / حجم
}؛

متغير المسافة: حقيقي = 100.0؛
متغير الزمن: حقيقي = 5.0؛
متغير السرعة: حقيقي = 0.0؛
متغير عداد: صحيح = 0؛

اجراء حساب_السرعة(المسافة: حقيقي, الزمن: حقيقي) يرجع حقيقي {
    اذا (الزمن <= 0.0) {
        سجل_حادثة "خطأ: الزمن يجب أن يكون أكبر من صفر"؛
        ارجع 0.0؛
    }
    ارجع المسافة / الزمن؛
}

وضع اقلاع {
    عند_بدء {
        سجل_حادثة "بدء اختبار الوحدات"؛
        
        السرعة = نفذ اجراء حساب_السرعة(المسافة, الزمن)؛
        
        اذا (السرعة > 15.0) {
            تنبيه مستوى_1 "السرعة عالية"؛
        } والا {
            تنبيه مستوى_1 "السرعة طبيعية"؛
        }
        
        طالما (عداد < 2) {
            سجل_حادثة "دورة حسابية"؛
            عداد = عداد + 1؛
        }
    }
}