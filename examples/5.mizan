// sample_5_voting.mizan
برنامج التصويت_والتحكم؛

جهاز وحدة_التحكم {
    نوع: "PLC",
    بروتوكول: "modbus_tcp",
    عنوان_ip: "127.0.0.1",
    منفذ: 5020,
    دورة_مسح: 500 مللي_ثانية,
};

حساس الحرارة {
    نوع: سيلزيوس,
    نطاق: [0..150],
    عنوان: 0x0008,
};

// Virtual sensors to simulate hardware redundancy
متغير الحرارة_وهمي_1: سيلزيوس = 0.0؛
متغير الحرارة_وهمي_2: سيلزيوس = 0.0؛

مشغل صمام_الدخول {
    نوع: منطقي,
    عنوان: 0x0020,
};

متغير حالة_الطوارئ: صحيح = 0؛

وضع اقلاع {
    عند_بدء {
        سجل "تهيئة نظام التصويت.."؛
        انتقل_الى معالجة؛
    }
}

وضع معالجة {
    قاعدة التشغيل {
        الحرارة_وهمي_1 = الحرارة؛
        الحرارة_وهمي_2 = الحرارة؛
        
        اذا (تصويت(2 من 3 : الحرارة > 100, الحرارة_وهمي_1 > 100, الحرارة_وهمي_2 > 100)) {
            تنبيه مستوى_2 "إجماع على الحرارة الحرجة!"؛
            حالة_الطوارئ = 1؛
            انتقل_الى طوارئ؛
        }
        
        امر صمام_الدخول: تشغيل؛
        حالة_الطوارئ = 0؛
    }
}

وضع طوارئ {
    عند_بدء {
        سجل "🚨 وضع الطوارئ: إغلاق جميع المشغلات"؛
        امر صمام_الدخول: ايقاف؛ // Watchdog Safe State
    }
    
    قاعدة التبريد {
        اذا (الحرارة < 7) {
            سجل "برد النظام، العودة للمعالجة"؛
            انتقل_الى معالجة؛
        }
    }
}

// ✅ DEMO: Transition Table Enforcement
انتقالات {
   من معالجة الى طوارئ؛
    من اقلاع الى معالجة؛
    من طوارئ الى معالجة؛
}