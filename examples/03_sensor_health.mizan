برنامج مراقبة_الحرارة_المتقدمة؛

جهاز وحدة_التحكم {
    نوع: "PLC",
    بروتوكول: "modbus_tcp",
    عنوان_ip: "127.0.0.1",
    منفذ: 5020,
    دورة_مسح: 1 ثانية
}؛

حساس حرارة_المحرك {
    نوع: سيلزيوس؛
    نطاق: [0..150]؛
    عنوان: 0x0008؛
    صحة {
        عند_انقطاع_الاتصال {
            تنبيه مستوى_3 "فقدان الاتصال"؛
            استخدم_قيمة_افتراضية: 0؛
        }؛
        عند_قيمة_ثابتة(مدة: 10 ثانية) {
            تنبيه مستوى_2 "قراءة ثابتة"؛
        }
    }
}؛

مشغل مروحة_التبريد {
    نوع: منطقي؛
    عنوان: 0x0020
}؛

وضع اقلاع {
    عند_بدء {
        سجل_حادثة "بدء نظام المراقبة"؛
        انتقل_الى مراقبة؛
    }
}

وضع مراقبة {
    قاعدة استمرار_الحرارة {
        متغير حالة: صحيح = 0؛
        متغير عداد: صحيح = 0؛
        شرط: عند_استمرار(حرارة_المحرك > 90 لمدة: 5 ثانية)؛
        تنفيذ {
            امر مروحة_التبريد: تشغيل؛
            اذا (حرارة_المحرك > 100) {
                حالة = 1؛
            } والا {
                حالة = 0؛
            }
            طالما (عداد < 1) {
                سجل_حادثة "تم تقييم الحالة"؛
                عداد = عداد + 1؛
            }
        }
    }
}

انتقالات {
    من اقلاع الى مراقبة؛
}