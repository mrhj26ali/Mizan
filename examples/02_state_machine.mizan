برنامج نظام_الاضاءة_الذكي؛

جهاز وحدة_التحكم {
    نوع: "PLC",
    بروتوكول: "modbus_tcp",
    عنوان_ip: "127.0.0.1",
    منفذ: 5020,
    دورة_مسح: 1 ثانية
}؛

حساس مستوى_الضوء {
    نوع: لا_وحدة؛
    نطاق: [0..100]؛
    عنوان: 0x0000
}؛

مشغل مصباح_الرئيسي {
    نوع: منطقي؛
    عنوان: 0x0020
}؛

وضع تشغيل {
    عند_بدء {
        سجل_حادثة "بدء النظام"؛
        انتقل_الى تشغيل_عادي؛
    }
}

وضع تشغيل_عادي {
    قاعدة تشغيل_الاضاءة {
        متغير حالة_النظام: صحيح = 0؛
        متغير عداد: صحيح = 0؛
        شرط: مستوى_الضوء < 30؛
        تنفيذ {
            امر مصباح_الرئيسي: تشغيل؛
            اذا (مستوى_الضوء > 80) {
                حالة_النظام = 1؛
            } والا {
                حالة_النظام = 2؛
            }
            طالما (عداد < 1) {
                سجل_حادثة "فحص دوري مكتمل"؛
                عداد = عداد + 1؛
            }
        }
    }
}

انتقالات {
    من تشغيل الى تشغيل_عادي؛
}