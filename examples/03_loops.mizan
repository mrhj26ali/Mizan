// examples/03_loops.mizan
// برنامج 3: حلقات التكرار — طالما

برنامج اختبار_الحلقة؛

متغير عداد: صحيح = 0؛
ثابت الحد_الاقصى: صحيح = 10؛

اجراء حساب_المجموع() {
    متغير مجموع: صحيح = 0؛
    طالما (عداد < الحد_الاقصى) {
        مجموع = مجموع + عداد؛
        عداد = عداد + 1؛
    }
    سجل_حادثة "اكتملت الحلقة"؛
}