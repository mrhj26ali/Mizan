// examples/02_conditionals.mizan
// برنامج 2: الجمل الشرطية — اذا / والا

برنامج اختبار_الشرط؛

متغير درجة_الحرارة: حقيقي = 75.0؛
متغير الحالة: صحيح = 0؛

اجراء تقييم_الحرارة() {
    اذا (درجة_الحرارة > 80.0) {
        سجل_حادثة "تحذير: درجة الحرارة مرتفعة جداً"؛
        الحالة = 2؛
    } والا {
        اذا (درجة_الحرارة > 60.0) {
            سجل_حادثة "تنبيه: درجة الحرارة مرتفعة"؛
            الحالة = 1؛
        } والا {
            سجل_حادثة "درجة الحرارة طبيعية"؛
            الحالة = 0؛
        }
    }
}