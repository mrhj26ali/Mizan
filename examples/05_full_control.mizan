// examples/05_full_control.mizan
// برنامج 5: التحكم الكامل — وضع + قواعد + شرط + حلقة + إجراء + تنبيه
// تم تحديث العناوين والمنطق ليتطابق تماماً مع محاكي محطة معالجة المياه (plant_simulator.py)

برنامج نظام_التحكم_الكامل؛

جهاز وحدة_التحكم {
نوع: "PLC",
بروتوكول: "modbus_tcp",
عنوان_ip: "127.0.0.1",
منفذ: 5020,
دورة_مسح: 1 ثانية
}؛

// ==================== الحساسات ====================
// تتطابق مع سجلات القراءة في المحاكي:
// 0x0000: Level, 0x0002: Turbidity, 0x0004: pH, 0x0008: Temp

حساس مستوى_الخزان {
نوع: متر؛
نطاق: [0..4]؛
عنوان: 0x0000؛
صحة {
عند_انقطاع_الاتصال {
تنبيه مستوى_2 "انقطع حساس المستوى"؛
}؛
عند_قيمة_ثابتة(مدة: 30 ثانية) {
تنبيه مستوى_1 "حساس المستوى يعطي قيمة ثابتة"؛
}
}
}؛

حساس العكارة {
نوع: NTU؛
نطاق: [0..50]؛
عنوان: 0x0002
}؛

حساس الرقم_الهيدروجيني {
نوع: لا_وحدة؛
نطاق: [0..14]؛
عنوان: 0x0004
}؛

حساس درجة_الحرارة {
نوع: سيلزيوس؛
نطاق: [0..150]؛
عنوان: 0x0008
}؛

// ==================== المشغلات ====================
// تتطابق مع سجلات الكتابة في المحاكي:
// 0x0020: Inlet, 0x0022: Outlet, 0x0024: Dosing
// 0x0026: Alarm (سجل افتراضي للمؤشر، المحاكي يتجاهله)

مشغل صمام_الدخول {
نوع: منطقي؛
عنوان: 0x0020
}؛

مشغل مضخة_الخروج {
نوع: منطقي؛
عنوان: 0x0022
}؛

مشغل مضخة_الكيماويات {
نوع: منطقي؛
عنوان: 0x0024
}؛

مشغل منبه_الإنذار {
نوع: منطقي؛
عنوان: 0x0026
}؛

// ==================== المتغيرات والإجراءات ====================
متغير عداد_التنبيهات: صحيح = 0؛

اجراء تسجيل_تنبيه() {
عداد_التنبيهات = عداد_التنبيهات + 1؛
سجل_حادثة "تم تسجيل تنبيه جديد"؛
}

// ==================== أوضاع التشغيل ====================
وضع اقلاع {
عند_بدء {
سجل_حادثة "بدء تشغيل نظام التحكم"؛
امر صمام_الدخول: ايقاف؛
امر مضخة_الخروج: ايقاف؛
امر مضخة_الكيماويات: ايقاف؛
امر منبه_الإنذار: ايقاف؛
انتقل_الى تشغيل؛
}
}

وضع تشغيل {
قاعدة تعبئة_الخزان {
شرط: مستوى_الخزان < 1.0؛
تنفيذ {
امر صمام_الدخول: تشغيل؛
}
}

قاعدة تصريف_الخزان {
شرط: مستوى_الخزان > 3.5؛
تنفيذ {
امر صمام_الدخول: ايقاف؛
امر مضخة_الخروج: تشغيل؛
}
}

قاعدة تحسين_العكارة {
شرط: العكارة > 5.0؛
تنفيذ {
امر صمام_الدخول: تشغيل؛ // ضخ ماء نقي لتخفيف العكارة
تنبيه مستوى_1 "العكارة مرتفعة، يتم ضخ ماء نقي"؛
نفذ اجراء تسجيل_تنبيه()؛
}
}

قاعدة ضبط_الكيماويات {
شرط: الرقم_الهيدروجيني < 6.5؛
تنفيذ {
امر مضخة_الكيماويات: تشغيل؛
}
}

قاعدة ايقاف_الكيماويات {
شرط: الرقم_الهيدروجيني > 7.5؛
تنفيذ {
امر مضخة_الكيماويات: ايقاف؛
}
}

قاعدة حالة_الطوارئ {
شرط: مستوى_الخزان > 3.8 او العكارة > 20.0؛
تنفيذ {
امر منبه_الإنذار: تشغيل؛
امر صمام_الدخول: ايقاف؛
امر مضخة_الخروج: تشغيل؛ // تفريغ الخزان بالكامل
تنبيه مستوى_3 "حالة طوارئ: فيضان أو عكارة حرجة"؛
انتقل_الى طوارئ؛
}
}
}

وضع طوارئ {
عند_بدء {
سجل_حادثة "الدخول لوضع الطوارئ"؛
امر منبه_الإنذار: تشغيل؛
}
قاعدة انتظار {
شرط: صح؛
تنفيذ {
استخدم_قيمة_افتراضية: 0؛
}
}
}

// ==================== جدول الانتقالات ====================
انتقالات {
من اقلاع الى تشغيل؛
من تشغيل الى طوارئ؛
من طوارئ الى تشغيل؛
}

// ==================== التقارير ====================
تقرير تقرير_اليومي {
جدول: كل_يوم الساعة "00:00"؛
تنسيق: json؛
حفظ_في: "./mizan_reports"؛
محتوى {
متوسط(العكارة خلال: 24 ساعة) بعنوان "متوسط العكارة"؛
اقصى(مستوى_الخزان خلال: 24 ساعة) بعنوان "أعلى مستوى"؛
الوضع_الحالي بعنوان "الوضع"؛
}
}