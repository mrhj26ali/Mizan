// examples/05_full_control.mizan
// برنامج 5: التحكم الكامل — وضع + قواعد + شرط + حلقة + إجراء + تنبيه
برنامج نظام_التحكم_الكامل؛

جهاز وحدة_التحكم {
نوع: "PLC",
بروتوكول: "modbus_tcp",
عنوان_ip: "127.0.0.1",
منفذ: 5020,
دورة_مسح: 1 ثانية
}؛

حساس درجة_الحرارة {
نوع: سيلزيوس؛
نطاق: [0..150]؛
عنوان: 0x0008؛  // <--- FIXED: Was 0x0000 (Water Level). 0x0008 is Temperature.
صحة {
عند_انقطاع_الاتصال {
تنبيه مستوى_2 "انقطع حساس الحرارة"؛
}؛
عند_قيمة_ثابتة(مدة: 30 ثانية) {
تنبيه مستوى_1 "حساس الحرارة يعطي قيمة ثابتة"؛
}
}
}؛

حساس الضغط {
نوع: بار؛
نطاق: [0..10]؛
عنوان: 0x0002   // <--- Reads Turbidity from the simulator (acts as the second sensor)
}؛

مشغل صمام_التبريد {
نوع: منطقي؛
عنوان: 0x0020
}؛

مشغل منبه_الإنذار {
نوع: منطقي؛
عنوان: 0x0022
}؛

متغير عداد_التنبيهات: صحيح = 0؛

اجراء تسجيل_تنبيه() {
عداد_التنبيهات = عداد_التنبيهات + 1؛
سجل_حادثة "تم تسجيل تنبيه جديد"؛
}

وضع اقلاع {
عند_بدء {
سجل_حادثة "بدء تشغيل نظام التحكم"؛
امر صمام_التبريد: ايقاف؛
امر منبه_الإنذار: ايقاف؛
انتقل_الى تشغيل؛
}
}

وضع تشغيل {
قاعدة تبريد_عند_الحرارة_العالية {
شرط: درجة_الحرارة > 85.0؛
تنفيذ {
امر صمام_التبريد: تشغيل؛
تنبيه مستوى_1 "تفعيل التبريد"؛
نفذ اجراء تسجيل_تنبيه()؛
}
}
قاعدة ايقاف_التبريد {
شرط: درجة_الحرارة < 70.0؛
تنفيذ {
امر صمام_التبريد: ايقاف؛
}
}
قاعدة حالة_الطوارئ {
شرط: درجة_الحرارة > 120.0 او الضغط > 9.0؛
تنفيذ {
امر منبه_الإنذار: تشغيل؛
تنبيه مستوى_3 "حالة طوارئ: حرارة أو ضغط خارج الحدود"؛
انتقل_الى طوارئ؛
}
}
قاعدة مراقبة_مستمرة {
شرط: عند_استمرار(درجة_الحرارة > 90.0 لمدة: 10 ثانية)؛
تنفيذ {
تنبيه مستوى_2 "الحرارة مرتفعة لمدة 10 ثوان متواصلة"؛
}
}
}

وضع طوارئ {
عند_بدء {
سجل_حادثة "الدخول لوضع الطوارئ"؛
امر منبه_الإنذار: تشغيل؛
}
قاعدة انتظار {
شرط: صح؛
تنفيذ {
استخدم_قيمة_افتراضية: 0؛
}
}
}

انتقالات {
من اقلاع الى تشغيل؛
من تشغيل الى طوارئ؛
من طوارئ الى تشغيل؛
}

تقرير تقرير_اليومي {
جدول: كل_يوم الساعة "00:00"؛
تنسيق: json؛
حفظ_في: "./mizan_reports"؛
محتوى {
متوسط(درجة_الحرارة خلال: 24 ساعة) بعنوان "متوسط الحرارة"؛
اقصى(الضغط خلال: 24 ساعة) بعنوان "أعلى ضغط"؛
الوضع_الحالي بعنوان "الوضع"؛
}
}