// examples/01_hello.mizan
// برنامج 1: مرحبا — أبسط برنامج ميزان

برنامج مرحبا؛

اجراء الرئيسي() {
    سجل_حادثة "مرحبا بالعالم من لغة ميزان"؛
    سجل_حادثة "هذه لغة برمجة عربية مُجمَّعة"؛
}

// في لغة ميزان، نقطة البداية لتنفيذ المنطق هي "وضع الاقلاع"
وضع اقلاع {
    عند_بدء {
        نفذ اجراء الرئيسي()؛
    }
}