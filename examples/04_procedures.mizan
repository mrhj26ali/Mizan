// examples/04_procedures.mizan
// برنامج 4: الإجراءات — استدعاء وإرجاع القيم

برنامج اختبار_الاجراءات؛

متغير النتيجة: حقيقي = 0.0؛

اجراء حساب_المساحة(الطول: حقيقي، العرض: حقيقي) يرجع حقيقي {
    متغير المساحة: حقيقي = الطول * العرض؛
    ارجع المساحة؛
}

اجراء التحقق_من_النتيجة(القيمة: حقيقي) {
    اذا (القيمة > 100.0) {
        سجل_حادثة "المساحة كبيرة"؛
    } والا {
        سجل_حادثة "المساحة صغيرة"؛
    }
}

اجراء الرئيسي() {
    النتيجة = نفذ اجراء حساب_المساحة(15.0، 8.0)؛
    نفذ اجراء التحقق_من_النتيجة(النتيجة)؛
}