// sample_3_health.mizan
برنامج مراقبة_الصحة؛

جهاز وحدة_التحكم {
    نوع: "PLC",
    بروتوكول: "modbus_tcp",
    عنوان_ip: "127.0.0.1",
    منفذ: 5020,
    دورة_مسح: 500 مللي_ثانية,
};

حساس الحرارة {
    نوع: سيلزيوس,
    نطاق: [0..150],
    عنوان: 0x0008,
    // ✅ DEMO: Hardware faults declared directly on the sensor
    صحة {
        عند_انقطاع_الاتصال {
            تنبيه مستوى_3 "فقدان الاتصال!"؛ // Fires EXACTLY ONCE
            قيمة_افتراضية: 25.0؛ // Watchdog applies safe state
        },
        عند_خروج_عن_النطاق {
            تنبيه مستوى_2 "القراءة خارج النطاق الآمن!"؛
        }
    }
};

متغير حالة_النظام: صحيح = 0؛

وضع اقلاع {
    عند_بدء {
        سجل "بدء مراقبة الصحة..."؛
        انتقل_الى مراقبة؛
    }
}

وضع مراقبة {
    قاعدة المراقبة {
        اذا (الحرارة > 50.0) {
            سجل "النظام يعمل."؛
            حالة_النظام = 1؛
        } والا {
            حالة_النظام = 0؛
        }
    }
}

انتقالات {
    من اقلاع الى مراقبة؛
}