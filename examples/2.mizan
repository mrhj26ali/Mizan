// sample_2_units.mizan
برنامج الأمان_الفيزيائي؛


وحدات_مخصصة {
    سرعة_تدفق : لتر / دقيقة
};
جهاز وحدة_التحكم {
    نوع: "PLC",
    بروتوكول: "modbus_tcp",
    عنوان_ip: "127.0.0.1",
    منفذ: 502٠,
    دورة_مسح: 500 مللي_ثانية,
};

حساس الحرارة {
    نوع: سيلزيوس,
    نطاق: [0..150],
    عنوان: 0x0008,
};
متغير ت: بار = الحرارة؛ 

مشغل مضخة_التبريد {
    نوع: منطقي,
    عنوان: 0x0022,
};

متغير حالة_التبريد: منطقي = خطا؛

وضع اقلاع {
    عند_بدء {
        سجل "بدء اختبار الأمان الفيزيائي..."؛
        
        
        
        انتقل_الى تشغيل؛
    }
}

وضع تشغيل {
    قاعدة التبريد_الزمني {
        
        اذا (عند_استمرار(الحرارة > 90 لمدة: ٥ ثانية)) {
            امر مضخة_التبريد: تشغيل؛
            سجل "حرارة مرتفعة باستمرار، تشغيل المضخة."؛
            حالة_التبريد = صح؛
        } والا {
            امر مضخة_التبريد: ايقاف؛
            حالة_التبريد = خطا؛
        }
    }
}

انتقالات {
    من اقلاع الى تشغيل؛
}