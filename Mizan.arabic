برنامج اختبار_التحسين ؛

// 1. المتغيرات
متغير س : صحيح = 5 ؛
متغير ص : صحيح = 10 ؛

// معادلة يمكن حسابها مسبقًا (طي الثوابت)
متغير ع : حقيقي = س + ص ؛ 

// كود ميت: متغير يُحجز في الذاكرة ولكن لا يُستخدم أبدًا
متغير مجهول : صحيح = 999 ؛ 

// فخ حماية: القسمة على ثابت
// زائرنا سيزرع فخًا للتأكد من أن "ص" ليس صفر
// لكن المحسن سيثبت رياضيًا أن "ص" هي 10 دائمًا، وسيحذف الفخ!
متغير النتيجة : حقيقي = 100 / ص ؛ 