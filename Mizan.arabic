برنامج النظام_الذكي_للمصنع ؛

// 1. المتغيرات والثوابت
متغير درجة_الحرارة : حقيقي = 25.0 ؛
متغير عداد_الدورات : صحيح = 0 ؛
ثابت الحد_الاقصى : حقيقي = 80.0 ؛

// ✅ تم إضافة تعريف المشغل هنا
مشغل منبه_النظام {
    نوع   : منطقي ،
    عنوان : 0x0101
} ؛

// 2. إجراء يحتوي على حلقة تكرارية وشروط
اجراء مراقبة_المصنع () {
    طالما ( عداد_الدورات < 5 ) {
        درجة_الحرارة = درجة_الحرارة + 15.0 ؛
        عداد_الدورات = عداد_الدورات + 1 ؛
        
        سجل_حادثة "الدورة الحالية: فحص الحرارة" ؛
        
        اذا ( درجة_الحرارة > الحد_الاقصى ) {
            تنبيه مستوى_1 "تحذير: الحرارة تجاوزت الحد المسموح!" ؛
            امر منبه_النظام : تشغيل ؛
        } والا {
            سجل_حادثة "الحرارة ضمن النطاق الآمن." ؛
        }
    }
}