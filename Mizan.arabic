برنامج نظام_حماية_المصنع ؛

// --- النطاقات العامة (Global Scope) ---
جهاز الحزام_الناقل {
    نوع       : "متحكم_منطقي" ،
    بروتوكول  : "modbus_tcp" ،
    عنوان_ip  : "192.168.1.50" ،
    منفذ      : 502 ،
    دورة_مسح  : 500 مللي_ثانية
} ؛

// 1. تعريف العتاد (حساسات ومشغلات)
حساس درجة_الحرارة {
    نوع : سيلزيوس ،
    نطاق : [ 0.0 .. 100.0 ] ،
    عنوان : 0x0001
} ؛

حساس الضغط {
    نوع : بار ،
    نطاق : [ 0.0 .. 20.0 ] ،
    عنوان : 0x0002
} ؛

مشغل منبه_النظام {
    نوع : منطقي ،
    عنوان : 0x0101
} ؛

// 2. المتغيرات والثوابت الفيزيائية (ISO 80000 Safety)
// لاحظ أننا نربط الثوابت بوحداتها الفيزيائية الصحيحة
ثابت عدد_المحاولات : صحيح = 3 ؛
ثابت حد_الامان : سيلزيوس = 80.0 ؛       // ✅ تم تغيير النوع من حقيقي إلى سيلزيوس
ثابت حد_الضغط_المرتفع : بار = 10.3 ؛    // ✅ ثابت جديد للضغط
ثابت حد_الضغط_الحرج : بار = 15.0 ؛      // ✅ ثابت جديد لوضع الصيانة
متغير مؤقت_ضغط : حقيقي = 0.0 ؛ 

// --- الإجراءات (Procedure Scope) ---
اجراء فحص_الحرارة () {
    // ✅ الآن المقارنة صحيحة فيزيائياً: سيلزيوس > سيلزيوس
    اذا ( درجة_الحرارة > حد_الامان ) {
        امر منبه_النظام : تشغيل ؛
    }
}

// --- الأوضاع والقواعد (Mode & Rule Scopes) ---
وضع تشغيل {
    عند_بدء {
        مؤقت_ضغط = 9.0 ؛ 
    }
    قاعدة مراقبة_الضغط {
        // ✅ المقارنة صحيحة فيزيائياً: بار > بار
        شرط : الضغط > حد_الضغط_المرتفع ؛
        تنفيذ { 
            سجل_حادثة "تم تجاوز حد الضغط" ؛
            امر منبه_النظام : تشغيل ؛
        }
    }
}

// وضع الصيانة: يثبت ميزة الأمان IEC 62443
وضع صيانة {
    قاعدة مراقبة_فقط {
        // ✅ المقارنة صحيحة فيزيائياً: بار > بار
        شرط : الضغط > حد_الضغط_الحرج ؛
        تنفيذ {
            // المترجم سيرفض أي "امر منبه_النظام" هنا بسبب وضع الصيانة
            تنبيه مستوى_2 "تحذير: ضغط مرتفع أثناء الصيانة" ؛
        }
    }
}