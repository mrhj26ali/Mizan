برنامج اختبار_محرك_النصوص ؛

// 1. المتغيرات
متغير العمر : صحيح = 25 ؛
متغير السنة_القادمة : صحيح = 0 ؛

// 2. إجراء يحتوي على اختبارات التشكيل والاتجاه
اجراء تشغيل_النظام () {
    السنة_القادمة = العمر + 1 ؛
    
    // اختبار 1: حروف لا تتصل (تتطلب أشكالاً معزولة/ابتدائية/وسطية/نهائية)
    سجل_حادثة "كتاب، بابا، قلم." ؛
    
    // اختبار 2: لا-ألف (Lam-Alef Ligatures)
    سجل_حادثة "قال: الإسلام، الله، لأن." ؛
    
    // اختبار 3: الخوارزمية ثنائية الاتجاه (Bidi) - نصوص إنجليزية وأرقام مع العربية
    سجل_حادثة "الحرارة اليوم 25 درجة مئوية." ؛
    سجل_حادثة "الإصدار v1.0 من لغة ميزان." ؛
    
    // اختبار 4: الطباعة العادية
    سجل_حادثة "تم حساب العمر بنجاح." ؛
}