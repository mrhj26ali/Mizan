برنامج نظام_حماية_المصنع ؛

// --- النطاقات العامة (Global Scope) ---
جهاز الحزام_الناقل {
    نوع       : "متحكم_منطقي" ،
    بروتوكول  : "modbus_tcp" ،
    عنوان_ip  : "192.168.1.50" ،
    منفذ      : 502 ،
    دورة_مسح  : 500 مللي_ثانية
} ؛

// 1. تعريف العتاد (حساسات ومشغلات)
حساس درجة_الحرارة {
    نوع   : سيلزيوس ،
    نطاق  : [ 0.0 .. 100.0 ] ،
    عنوان : 0x0001
} ؛

حساس الضغط {
    نوع   : بار ،
    نطاق  : [ 0.0 .. 20.0 ] ،
    عنوان : 0x0002
} ؛

مشغل منبه_النظام {
    نوع   : منطقي ،
    عنوان : 0x0101
} ؛

// 2. المتغيرات والثوابت الفيزيائية
ثابت عدد_المحاولات : صحيح = 3 ؛
ثابت حد_الامان : سيلزيوس = 80.0 ؛
ثابت حد_الضغط_المرتفع : بار = 10.3 ؛
ثابت حد_الضغط_الحرج : بار = 15.0 ؛
متغير مؤقت_ضغط : حقيقي = 0.0 ؛

// 3. متغيرات مجردة من الوحدات للعمليات الرياضية المعقدة
متغير حرارة_خام : حقيقي = 0.0 ؛
متغير ضغط_خام : حقيقي = 0.0 ؛

// --- الإجراءات (Procedure Scope) ---
اجراء فحص_الحرارة () {
    اذا ( درجة_الحرارة > 80.0 ) {
        امر منبه_النظام : تشغيل ؛
    }
    
    اذا ( درجة_الحرارة > حد_الامان ) {
        امر منبه_النظام : تشغيل ؛
    }
}

// --- الأوضاع والقواعد (Mode & Rule Scopes) ---
وضع تشغيل {
    عند_بدء {
        مؤقت_ضغط = 9.0 ؛
    }
    قاعدة مراقبة_الضغط {
        شرط : الضغط > 10.3 ؛
        تنفيذ {
            سجل_حادثة "تم تجاوز حد الضغط" ؛
            امر منبه_النظام : تشغيل ؛
        }
    }
    
    // ✅ تم نقل تعريف المتغير إلى localDecl (قبل شرط)
    قاعدة معالجة_رياضية_مجردة {
        متغير نتيجة : حقيقي = 0.0 ؛ // ✅ localDecl
        شرط : صح ؛
        تنفيذ {
            حرارة_خام = درجة_الحرارة ؛ // ✅ Unit Stripping
            ضغط_خام = الضغط ؛         // ✅ Unit Stripping
            نتيجة = حرارة_خام + ضغط_خام ؛ // ✅ Raw math
        }
    }
}

// وضع الصيانة
وضع صيانة {
    قاعدة مراقبة_فقط {
        شرط : الضغط > 15.0 ؛
        تنفيذ {
            تنبيه مستوى_2 "تحذير: ضغط مرتفع أثناء الصيانة" ؛
        }
    }
}